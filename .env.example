PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ALEON uses Audius as the primary direct-audio playback provider.
# Most read-only calls work without credentials. Creating a free Audius developer
# app gives you an API Key plus a Bearer Token. Keep the Bearer Token server-side.
# https://api.audius.co/plans
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=

# YouTube Data API v3 is the broad catalog/playback fallback. Search needs an API key;
# playback itself uses the official visible YouTube iframe in the frontend.
# Keep this key in Render/backend only, not in VITE_* variables.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=CO

# Optional canonical-only fallback. ALEON never uses raw SoundCloud search results
# as the primary catalog. Credentials improve fallback reliability if available.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
