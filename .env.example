PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Recomendado para producción y para consultar únicamente contenido que
# SoundCloud autoriza como playable fuera de su plataforma.
# Registra la app en SoundCloud Developers y guarda el secret solo en backend.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
