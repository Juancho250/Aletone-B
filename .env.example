PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ALEON uses Audius as the primary full-track playback provider.
# Read-only requests work without a key. A free key is recommended for higher limits.
# https://api.audius.co/plans
AUDIUS_API_KEY=

# Optional canonical-only fallback. ALEON never uses raw SoundCloud search results
# as the primary catalog anymore. Credentials improve fallback reliability if available.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
